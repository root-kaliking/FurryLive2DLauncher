<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launcher_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- 壁纸层：图片/视频/内置场景 -->
    <FrameLayout
        android:id="@+id/wallpaper_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 桌面分页层 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/home_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 桌面指示器 -->
    <LinearLayout
        android:id="@+id/page_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="88dp"
        android:orientation="horizontal" />

    <!-- Live2D 模型层：覆盖在桌面上方 -->
    <com.furry.live2dlauncher.live2d.Live2DOverlayView
        android:id="@+id/live2d_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 底部 Dock -->
    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_dock"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp" />

    <!-- 上滑指示条 -->
    <View
        android:id="@+id/drawer_handle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_drawer_handle" />

    <!-- 应用抽屉 -->
    <FrameLayout
        android:id="@+id/drawer_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:visibility="gone" />
</FrameLayout>
